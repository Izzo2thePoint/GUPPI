{
  "name": "guppi2",
  "productName": "GUPPI",
  "version": "2.1.0",
  "description": "GUPPI 2 — mission control for Neumann Probe",
  "private": true,
  "type": "module",
  "main": "build/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:sim": "vite --mode simulator",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "net.neumannprobe.guppi2",
    "productName": "GUPPI",
    "copyright": "Independent fan-made companion for Neumann Probe",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "build/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GUPPI",
      "artifactName": "GUPPI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GUPPI-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build-resources/icon.png",
      "artifactName": "GUPPI-${version}-${arch}.${ext}",
      "executableName": "guppi"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "author": "Izzo2thePoint",
  "homepage": "https://github.com/Izzo2thePoint/GUPPI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Izzo2thePoint/GUPPI.git"
  }
}
