{
  "name": "neumann-mission-cockpit",
  "productName": "GUPPI",
  "version": "1.16.1",
  "description": "GUPPI desktop mission control for Neumann Probe",
  "author": "Neumann Mission Cockpit",
  "private": true,
  "main": "build/electron/main.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "package": "node scripts/package.cjs",
    "start": "electron ."
  },
  "dependencies": {},
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "shadcn": "4.18.0",
    "tw-animate-css": "1.4.0",
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "esbuild": "0.27.3",
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "net.neumannprobe.missioncockpit",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "GUPPI.exe"
    }
  }
}



